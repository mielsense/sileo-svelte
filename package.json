{
    "name": "sileo-svelte",
    "version": "0.1.1",
    "description": "Physics-based gooey toast notifications for Svelte 5",
    "license": "MIT",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "test": "vitest run --exclude tests/package.test.ts",
        "test:package": "vitest run tests/package.test.ts",
        "test:watch": "vitest",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.2",
        "@eslint/js": "^9.39.2",
        "@sveltejs/adapter-auto": "^7.0.0",
        "@sveltejs/kit": "^2.50.2",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^24",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.3.0",
        "happy-dom": "^20.11.1",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.4.1",
        "publint": "^0.3.17",
        "svelte": "^5.49.2",
        "svelte-check": "^4.3.6",
        "svelte-highlight": "^7.16.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "vite": "^7.3.1",
        "vitest": "^4.1.10"
    },
    "keywords": [
        "svelte",
        "svelte5",
        "toast",
        "notifications",
        "sileo"
    ],
    "main": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mielsense/sileo-svelte.git"
    },
    "author": "https://github.com/mielsense",
    "bugs": {
        "url": "https://github.com/mielsense/sileo-svelte/issues"
    },
    "homepage": "https://github.com/mielsense/sileo-svelte#readme"
}
