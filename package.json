{
    "name": "sileo-svelte",
    "version": "0.1.1",
    "packageManager": "bun@1.3.14",
    "description": "Physics-based gooey toast notifications for Svelte 5",
    "license": "MIT",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && publint",
        "test": "vitest run --exclude tests/package.test.ts",
        "test:browser": "playwright test",
        "test:package": "vitest run tests/package.test.ts",
        "test:watch": "vitest",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "peerDependencies": {
        "svelte": "^5.56.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.62.1",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^24.13.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "happy-dom": "^20.11.6",
        "mdsvex": "^0.12.8",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^3.5.2",
        "publint": "^0.3.24",
        "shiki": "^4.4.3",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "svelte-highlight": "^7.19.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.11"
    },
    "keywords": [
        "svelte",
        "svelte5",
        "toast",
        "notifications",
        "sileo"
    ],
    "main": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mielsense/sileo-svelte.git"
    },
    "author": "https://github.com/mielsense",
    "bugs": {
        "url": "https://github.com/mielsense/sileo-svelte/issues"
    },
    "homepage": "https://github.com/mielsense/sileo-svelte#readme",
    "dependencies": {
        "motion": "^13.1.1"
    },
    "overrides": {
        "brace-expansion": "^1.1.17",
        "cookie": "^0.7.2",
        "flatted": "^3.4.0",
        "nanoid": "^3.3.16",
        "picomatch": "^4.0.4",
        "postcss": "^8.5.23",
        "rollup": "^4.59.0",
        "yaml": "^1.10.3"
    }
}
